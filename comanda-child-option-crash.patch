+
+describe('resolveComandaChildLabel', () => {
+	const options = [{ item_option: { id: 7, name: 'Grande' } }];
+
+	it('prefixes the option name on a match', () => {
+		expect(resolveComandaChildLabel(options, 7, 'Taco')).toBe('Grande Taco');
+	});
+
+	it('prints the bare item name when the child has no option (shared item_group)', () => {
+		expect(resolveComandaChildLabel([], null, 'Printer Ticket Stock Item'))
+			.toBe('Printer Ticket Stock Item');
+	});
+
+	it('prints the bare item name when the option was deleted', () => {
+		expect(resolveComandaChildLabel(options, 999, 'Taco')).toBe('Taco');
+	});
+
+	it('does not throw when the option list is missing', () => {
+		expect(() => resolveComandaChildLabel(undefined, null, 'Taco')).not.toThrow();
+		expect(resolveComandaChildLabel(undefined, null, 'Taco')).toBe('Taco');
+	});
+});
